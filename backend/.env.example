# ── Variables de Entorno — Master Auth API ─────────────────────────────────────
# INSTRUCCIONES:
# 1. Copia este archivo como '.env' en la carpeta backend/
# 2. Completa los valores reales (NUNCA subas el .env al repositorio)
# 3. En producción, configura estos valores en los Secrets de GitHub Actions
#    y en las variables de entorno de Render.

# ── Base de Datos ───────────────────────────────────────────────────────────────
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/master_auth

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIA_ESTO_EN_PRODUCCION_genera_con_secrets_token_hex_32
JWT_ALGORITHM=HS256

# Tiempos de expiración (en minutos / días)
TEMP_TOKEN_EXPIRE_MINUTES=5
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Bcrypt ──────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── App ─────────────────────────────────────────────────────────────────────────
DEBUG=False
